# Build output
build/
cmake-build-*/
compile_commands.json
.cache/

# Runtime folders the manager creates in local mode (fake storage, fake queue, job work dirs)
run/

# macOS
.DS_Store

# Editors (keep the shared VS Code settings, ignore personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Compiled files
*.o
*.a
*.dylib
*.so
*.out

# Secrets: never commit AWS keys
.env
*.pem
credentials

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
